NODE_ENV=development
PORT=4500
# Postgres connection string (Neon: use the pooled URL with sslmode=require)
DATABASE_URL=
# At least 32 characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRATION_DURATION=7d
# Comma-separated allowed origins; `*` wildcard supported (e.g. https://share-it-social-*.vercel.app)
CLIENT_ORIGINS=http://localhost:3000
