{
  "name": "share-it-server",
  "version": "3.0.0",
  "description": "Backend server for SHARE-IT - A modern, full-stack social media platform built with Express.js, TypeScript, and PostgreSQL",
  "main": "dist/app.js",
  "type": "commonjs",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knex": "tsx node_modules/knex/bin/cli.js --knexfile knexfile.ts",
    "migrate:latest": "npm run knex -- migrate:latest",
    "migrate:rollback": "npm run knex -- migrate:rollback --all",
    "migrate:make": "npm run knex -- migrate:make -x ts",
    "seed": "tsx src/seeds/seeder.ts",
    "db:reset": "npm run migrate:rollback && npm run migrate:latest && npm run seed",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "social-media",
    "express",
    "typescript",
    "postgresql",
    "objection",
    "knex",
    "jwt",
    "zod",
    "backend",
    "api",
    "rest-api"
  ],
  "author": {
    "name": "Somraj Mukherjee",
    "email": "iamsomraj@gmail.com",
    "url": "https://github.com/iamsomraj"
  },
  "license": "MIT",
  "homepage": "https://share-it-social.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamsomraj/SHARE-IT-social-media-application.git",
    "directory": "server"
  },
  "bugs": {
    "url": "https://github.com/iamsomraj/SHARE-IT-social-media-application/issues"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "objection": "^3.1.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
